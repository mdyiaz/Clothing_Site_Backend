# --- Runtime ---
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
FRONTEND_URL=http://localhost:3000
TRUST_PROXY=1

# --- Database ---
DATABASE_URL=postgresql://rangoli:rangoli_secret@localhost:5432/rangoli?schema=public
DIRECT_URL=postgresql://rangoli:rangoli_secret@localhost:5432/rangoli?schema=public

# --- Redis (cache + queue; optional in Phase 1) ---
REDIS_URL=redis://localhost:6379

# --- Auth (NextAuth / JWT) ---
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-48-byte-random-secret
JWT_REFRESH_SECRET=change-me-to-a-different-48-byte-random-secret
# Optional; defaults to JWT_SECRET. Signs single-use password-reset tokens (30 min).
JWT_RESET_SECRET=change-me-to-another-48-byte-random-secret
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=7d
# Must match the NextAuth secret of Rangoli-admin / Rangoli-frontend
NEXTAUTH_SECRET=change-me-to-match-nextauth-secret

# --- Media ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Notifications (email + SMS; both optional, log-only when disabled) ---
MAIL_ENABLED=false
MAIL_PROVIDER=resend
MAIL_API_URL=https://api.resend.com/emails
MAIL_API_KEY=
MAIL_FROM=no-reply@rangoli.com.bd
MAIL_FROM_NAME=Rangoli

SMS_ENABLED=false
SMS_PROVIDER=generic
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=RANGOLI

# --- Online payments (bKash / SSLCommerz) ---
PAYMENT_CALLBACK_BASE_URL=http://localhost:4000/api/v1/payments
BKASH_ENABLED=false
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
SSLCOMMERZ_ENABLED=false
SSLCOMMERZ_BASE_URL=https://sandbox.sslcommerz.com
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=

# --- AI chatbot (Groq; catalog fallback when disabled) ---
GROQ_ENABLED=false
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-8b-instant

# --- 3PL courier (Pathao / RedX) ---
THREEPL_DEFAULT_COURIER=PATHAO
PATHAO_ENABLED=false
PATHAO_BASE_URL=https://api-hermes.pathao.com
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_STORE_ID=
REDX_ENABLED=false
REDX_BASE_URL=https://openapi.redx.com.bd/v1.0.0-beta
REDX_API_KEY=

# --- Observability ---
SENTRY_DSN=
LOG_LEVEL=log
